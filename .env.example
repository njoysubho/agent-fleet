# Copy to .env and fill in secrets.

# --- Core ---
REDIS_URL=redis://redis:6379/0

# FastAPI auth
API_SECRET_KEY=change-me

# Anthropic
ANTHROPIC_API_KEY=

# Agent defaults
LEADER_ID=leader-0
WORKER_COUNT=3
MODEL=

# Agent SDK runtime tuning
AGENT_PERMISSION_MODE=bypassPermissions
AGENT_MAX_TURNS=30
AGENT_MAX_BUDGET_USD=2.0

# SDK mode
# - live: use claude-agent-sdk (requires ANTHROPIC_API_KEY + quota)
# - dry_run: skip SDK calls (useful for end-to-end wiring tests)
AGENT_SDK_MODE=live
AGENT_PLANNER_TIMEOUT=30

# Orchestrator (ephemeral crews)
AGENTS_IMAGE=agentfleet-agents:latest
DOCKER_NETWORK=agentfleet_default
REPO_VOLUME=agentfleet_repo
MAX_WORKERS_PER_JOB=6
CLEANUP_DELAY_SECONDS=0

# Dry-run behavior
DRY_RUN_SLEEP_SECONDS=0
